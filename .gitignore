# Secrets — never commit
.env
*.token.json
credentials.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# The vault lives elsewhere and is its own repo.
# If someone symlinks or clones it in here, don't track it.
/vault/

# Local state
*.db-journal
*.db-wal
*.db-shm

# The app's own log lives in %LOCALAPPDATA%\quartermaster\Logs - a *.log here
# means someone redirected a manual run's output into the repo by hand.
*.log
