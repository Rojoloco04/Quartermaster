# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Paths ---
# Where your vault lives. Its own git repo, outside this one.
QM_VAULT_PATH=C:\Users\you\Vault

# Stable path to the Claude Code CLI. The Agent SDK spawns this.
# Leave blank to let the SDK find it on PATH.
QM_CLAUDE_CLI=

# --- Phase 1: Notion ---
# Internal integration token from notion.so/my-integrations
NOTION_TOKEN=

# --- Phase 2: Discord ---
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=

# --- Phase 3: Google (Calendar read/write + Gmail read-only). OAuth client type: Desktop app ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Phase 3: Microsoft To Do (Graph API). App registration: public client,
# platform "Mobile and desktop applications", redirect URI http://localhost.
# No client secret - a public client has none. ---
MS_CLIENT_ID=
MS_TENANT_ID=consumers

# --- Phase 3/4: Spotify ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Phase 4: Ticketmaster ---
TICKETMASTER_API_KEY=

# --- Optional: GIF search (free key at partner.klipy.com) ---
KLIPY_API_KEY=
