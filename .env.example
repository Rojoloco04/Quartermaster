# Copy to .env and fill in. .env is gitignored; never commit it.
# Where the vault lives (its own private git repo).
QM_VAULT_PATH=C:\Users\you\Vault

# Path to the native claude.exe. Blank = find it on PATH.
QM_CLAUDE_CLI=

# Notion internal integration token (notion.so/my-integrations).
NOTION_TOKEN=

# Discord bot token (discord.com/developers/applications).
DISCORD_BOT_TOKEN=

# Your Discord user id: the only person with vault access.
DISCORD_OWNER_ID=

# Google OAuth client, type Desktop app (Calendar + Gmail read-only).
GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

# Azure app for Microsoft To Do: public client, redirect http://localhost.
MS_CLIENT_ID=

# consumers = personal Microsoft accounts.
MS_TENANT_ID=consumers

# Spotify app; redirect URI must be http://127.0.0.1:8765/callback.
SPOTIFY_CLIENT_ID=

SPOTIFY_CLIENT_SECRET=

# Last.fm API key (last.fm/api/account/create). Taste signal.
LASTFM_API_KEY=

# Your Last.fm username.
LASTFM_USER=

# Ticketmaster Discovery API key (developer.ticketmaster.com).
TICKETMASTER_API_KEY=

# Optional. Klipy key for gif search (partner.klipy.com).
KLIPY_API_KEY=
